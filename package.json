{
  "name": "notkaramel.github.io",
  "private": true,
  "version": "3.0.0-restart",
  "type": "module",
  "scripts": {
    "new": "bun run src/lib/newblog.ts",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "gray-matter": "^4.0.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "animejs": "^4.5.0",
    "daisyui": "^5.8.1",
    "marked": "^17.0.6",
    "tailwindcss": "^4.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#schemas": "./src/lib/schemas.ts",
    "#app.css": "./src/app.css"
  }
}
