---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Music"
  description="MuseScore embeds and notes—placeholder layout until your scores are linked."
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">
        <a href="/art">Art</a> / Music
      </p>
      <h1>Music</h1>
      <p class="lede">
        Drop a MuseScore URL into an embed component later. For now, this frame keeps
        the correct aspect ratio without loading third-party scripts.
      </p>
    </header>

    <section class="surface embed" aria-label="MuseScore embed placeholder">
      <div class="chrome" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="body">
        <p class="title">MuseScore embed placeholder</p>
        <p class="muted">
          Typical embeds are wide (~100%) and ~180–220px tall. Paste your official
          MuseScore share snippet when ready.
        </p>
        <div class="fake" role="img" aria-label="Abstract score preview placeholder">
          <div class="staff"></div>
          <div class="staff short"></div>
          <div class="staff"></div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-m);
  }

  .page-head {
    margin-bottom: var(--space-xl);
  }

  .kicker {
    margin: 0 0 var(--space-s);
    font-weight: 750;
    color: var(--color-muted);
  }

  .kicker a {
    color: inherit;
    text-decoration: none;
  }

  .kicker a:hover {
    color: var(--color-link);
  }

  .lede {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .embed {
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    padding: 0;
  }

  .chrome {
    display: flex;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    background: color-mix(in oklab, var(--color-ink) 6%, white);
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
  }

  .chrome span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink) 18%, white);
  }

  .body {
    padding: var(--space-m);
  }

  .title {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .muted {
    margin: 0 0 var(--space-m);
    color: var(--color-muted);
  }

  .fake {
    border-radius: 14px;
    border: 1px dashed color-mix(in oklab, var(--color-ink) 22%, transparent);
    padding: var(--space-m);
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-primary) 22%, white),
      color-mix(in oklab, var(--color-secondary) 18%, white)
    );
    min-height: 200px;
    display: grid;
    gap: 0.75rem;
    align-content: center;
  }

  .staff {
    height: 10px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
  }

  .staff.short {
    width: 70%;
  }
</style>
