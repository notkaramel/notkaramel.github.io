---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const photos = await getCollection("art", ({ data }) => !data.draft);
photos.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

const byCat = ["portrait", "landscape", "other"] as const;
const catLabel: Record<(typeof byCat)[number], string> = {
  portrait: "Portraits",
  landscape: "Landscapes",
  other: "Other",
};
---

<BaseLayout
  title="Gallery"
  description="Photography gallery with lazy-loaded placeholder images."
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">
        <a href="/art">Art</a> / Gallery
      </p>
      <h1>Gallery</h1>
      <p class="lede">
        Images are plain <code>&lt;img&gt;</code> tags with <code>loading="lazy"</code>{" "}
        and responsive widths. Swap SVG placeholders for compressed photos when you
        have them.
      </p>
    </header>

    {
      byCat.map((cat) => {
        const items = photos.filter((p) => p.data.category === cat);
        if (items.length === 0) return null;
        return (
          <section class="block">
            <h2>{catLabel[cat]}</h2>
            <div class="grid">
              {items.map((p) => (
                <figure class="card surface">
                  <div class="frame">
                    <img
                      src={p.data.image}
                      alt={p.data.alt}
                      width="900"
                      height="900"
                      loading="lazy"
                      decoding="async"
                      sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 33vw"
                    />
                  </div>
                  <figcaption>
                    <div class="cap-title">{p.data.title}</div>
                    <div class="cap-body">
                      <p>{p.data.caption}</p>
                    </div>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-m);
  }

  .page-head {
    margin-bottom: var(--space-xl);
    max-width: 52rem;
  }

  .kicker {
    margin: 0 0 var(--space-s);
    font-weight: 750;
    color: var(--color-muted);
  }

  .kicker a {
    color: inherit;
    text-decoration: none;
  }

  .kicker a:hover {
    color: var(--color-link);
  }

  .lede {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .block {
    margin-bottom: var(--space-xl);
  }

  h2 {
    margin: 0 0 var(--space-m);
    font-family: var(--font-display);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-m);
  }

  .card {
    margin: 0;
    border-radius: calc(var(--radius) + 6px);
    overflow: clip;
    display: grid;
    gap: 0;
  }

  .frame {
    background: color-mix(in oklab, var(--color-bg) 70%, white);
  }

  img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  figcaption {
    padding: var(--space-m);
  }

  .cap-title {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .cap-body p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
