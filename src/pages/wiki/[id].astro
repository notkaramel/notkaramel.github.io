---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WikiShell from "@/components/wiki/WikiShell.astro";
import Prose from "@/components/ui/Prose.astro";

export async function getStaticPaths() {
  const items = await getCollection("wiki", ({ data }) => !data.draft);
  return items.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const all = await getCollection("wiki", ({ data }) => !data.draft);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <WikiShell entries={all} currentId={post.id}>
    <article>
      <header class="head">
        <p class="kicker">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </header>
      <Prose>
        <Content />
      </Prose>
    </article>
  </WikiShell>
</BaseLayout>

<style>
  .head {
    margin-bottom: var(--space-l);
  }

  .kicker {
    margin: 0 0 var(--space-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .lede {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step-1);
  }
</style>
