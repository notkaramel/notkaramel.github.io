---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Essays, fragments, and notes that refuse a single genre.">
  <div class="wrap">
    <header class="page-head">
      <h1>Blog</h1>
      <p class="lede">
        Markdown-first posts live in <code>src/content/blog/</code>. Voice notes can
        join later via frontmatter.
      </p>
    </header>
    <ul class="list">
      {
        posts.map((post) => (
          <li class="row surface">
            <div>
              <a class="title" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
              <p class="desc">{post.data.description}</p>
              <div class="cluster">
                {post.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
            <time class="date" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(undefined, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-m);
  }

  .page-head {
    margin-bottom: var(--space-xl);
  }

  .lede {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-m);
    align-items: start;
    border-radius: calc(var(--radius) + 4px);
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
    }
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-decoration: none;
    color: var(--color-ink);
  }

  .title:hover {
    color: var(--color-link-hover);
  }

  .desc {
    margin: var(--space-xs) 0 var(--space-s);
    color: var(--color-muted);
  }

  .date {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
