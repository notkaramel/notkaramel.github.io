---
const tiles = [
  {
    href: "/projects",
    label: "Projects",
    blurb: "Web experiments and repos",
    shape: "circle",
    tone: "blue",
  },
  {
    href: "/art",
    label: "Art",
    blurb: "Music scores & photographs",
    shape: "square",
    tone: "teal",
  },
  {
    href: "/experience",
    label: "Experience",
    blurb: "Work, study, research",
    shape: "diamond",
    tone: "orange",
  },
  {
    href: "/blog",
    label: "Blog",
    blurb: "Essays and stray thoughts",
    shape: "square",
    tone: "blue",
  },
  {
    href: "/wiki",
    label: "Wiki",
    blurb: "Practical technical notes",
    shape: "circle",
    tone: "teal",
  },
] as const;
---

<section class="stage" aria-label="Choose a section">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="intro">
    <p class="kicker">Personal site</p>
    <h1>Pick a door.</h1>
    <p class="lede">
      Hover to peek; click to wander. Each tile opens a different corner of this
      site—projects, art, experience, writing, and a small technical wiki.
    </p>
  </div>
  <ul class="tiles">
    {
      tiles.map((t) => (
        <li class:list={["tile", t.shape, `tone-${t.tone}`]}>
          <a class="tile-link" href={t.href}>
            <span class="tile-label">{t.label}</span>
            <span class="tile-blurb">{t.blurb}</span>
            <span class="tile-cta">Enter →</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .stage {
    position: relative;
    padding: var(--space-xl) var(--space-m) calc(var(--space-xl) * 1.25);
    overflow: clip;
  }

  .backdrop {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(
        circle at 20% 20%,
        color-mix(in oklab, var(--color-primary) 55%, white),
        transparent 45%
      ),
      radial-gradient(
        circle at 80% 10%,
        color-mix(in oklab, var(--color-secondary) 45%, white),
        transparent 40%
      ),
      radial-gradient(
        circle at 70% 80%,
        color-mix(in oklab, var(--color-accent) 50%, white),
        transparent 42%
      );
    opacity: 0.55;
    filter: saturate(1.05);
    pointer-events: none;
  }

  .intro {
    position: relative;
    max-width: 40rem;
    margin-bottom: var(--space-xl);
  }

  .kicker {
    margin: 0 0 var(--space-s);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .lede {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .tiles {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-m);
    align-items: stretch;
  }

  .tile {
    grid-column: span 4;
    min-height: 9.5rem;
  }

  .tile:nth-child(1) {
    grid-column: span 5;
    transform: rotate(-1.2deg);
  }

  .tile:nth-child(2) {
    grid-column: span 7;
    transform: rotate(0.8deg);
  }

  .tile:nth-child(3) {
    grid-column: span 6;
    transform: rotate(0.4deg);
  }

  .tile:nth-child(4) {
    grid-column: span 6;
    transform: rotate(-0.6deg);
  }

  .tile:nth-child(5) {
    grid-column: span 12;
    max-width: 28rem;
    justify-self: start;
    transform: rotate(-0.3deg);
  }

  @media (max-width: 860px) {
    .tile,
    .tile:nth-child(n) {
      grid-column: 1 / -1;
      transform: none;
      max-width: none;
    }
  }

  .tile-link {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-m);
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid color-mix(in oklab, var(--color-ink) 14%, transparent);
    background: color-mix(in oklab, var(--color-surface) 86%, transparent);
    box-shadow: 0 10px 30px color-mix(in oklab, var(--color-ink) 8%, transparent);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      background 220ms ease;
    will-change: transform;
  }

  .circle .tile-link {
    border-radius: 999px;
    aspect-ratio: 1 / 1;
    max-width: 14rem;
    margin-inline: auto;
  }

  .square .tile-link {
    border-radius: 22px;
  }

  .diamond .tile-link {
    border-radius: 6px 22px 6px 22px;
  }

  .tone-blue .tile-link {
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--color-primary) 40%, white),
      var(--color-surface)
    );
  }

  .tone-teal .tile-link {
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--color-secondary) 38%, white),
      var(--color-surface)
    );
  }

  .tone-orange .tile-link {
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--color-accent) 42%, white),
      var(--color-surface)
    );
  }

  .tile-link:hover {
    transform: scale(1.04) translateY(-2px);
    box-shadow: 0 18px 40px color-mix(in oklab, var(--color-ink) 12%, transparent);
    border-color: color-mix(in oklab, var(--color-ink) 22%, transparent);
  }

  .tile-link:active {
    transform: scale(0.985);
  }

  .tile-label {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .tile-blurb {
    color: var(--color-muted);
    font-size: var(--step-0);
  }

  .tile-cta {
    margin-top: var(--space-s);
    font-weight: 700;
    color: var(--color-link);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-link:hover {
      transform: none;
    }
  }
</style>
